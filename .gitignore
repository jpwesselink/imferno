# MXF test data (fetched from GitHub Release assets, not stored in git)
*.mxf

# Exception: small, curated MXF unit-test fixtures live in the
# imferno-core tests/ tree. Each is <50KB and synthesised /
# trimmed specifically for the audio-MCA / video / timed-text
# rule tests, so we keep them in git rather than the
# release-tarball pipeline used for full IMF packages.
!crates/imferno-core/tests/fixtures/mxf/*.mxf

# Fixture media (large production IMF packages)
fixture/

# Large / copyrighted SMPTE registers go elsewhere — see specs/README.md.
# specs/ itself is checked in: the SMPTE XSDs are BSD-licensed
# (redistribution permitted with the copyright notice retained).

# Rust
/target
**/*.rs.bk
Cargo.lock

# WASM build output
crates/imferno-wasm/pkg/
crates/imferno-wasm/imferno_wasm.js
crates/imferno-wasm/imferno_wasm.d.ts
crates/imferno-wasm/imferno_wasm_bg.wasm
crates/imferno-wasm/imferno_wasm_bg.wasm.d.ts
bindings/

# Native binaries in npm platform packages (placed by CI)
crates/imferno/npm/imferno-*/imferno
crates/imferno/npm/imferno-*/imferno.exe

# NAPI build output
crates/imferno-napi/*.node
crates/imferno-napi/npm/node-*/*.node

# Generated JSON schemas (built by cargo xtask generate-schema)
crates/imferno-core/npm/schema/schemas/

# Node / JS
node_modules/
package-lock.json

# AWS SDK logs
*.log

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.iml

# Generated files
test-typed.html
test-typed-complete.html
tmp
.cargo/*
!.cargo/config.toml
!.cargo/audit.toml
.claude/worktrees/
