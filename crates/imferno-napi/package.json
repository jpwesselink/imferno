{
  "name": "@imferno/node",
  "version": "0.1.0",
  "description": "Native Node.js bindings for the imferno SMPTE ST 2067 IMF validator",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "napi": {
    "binaryName": "imferno-node",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@imferno/node-darwin-arm64": "0.1.0",
    "@imferno/node-darwin-x64": "0.1.0",
    "@imferno/node-linux-x64-gnu": "0.1.0",
    "@imferno/node-linux-arm64-gnu": "0.1.0",
    "@imferno/node-win32-x64-msvc": "0.1.0",
    "@imferno/node-win32-arm64-msvc": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpwesselink/imferno.git"
  },
  "homepage": "https://github.com/jpwesselink/imferno",
  "bugs": {
    "url": "https://github.com/jpwesselink/imferno/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
