---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ImfPlayground from '../components/ImfPlayground';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<StarlightPage frontmatter={{ title: 'imferno', template: 'splash', hero: { tagline: '' }, tableOfContents: false }}>
  <div class="homepage">

    <!-- Hero -->
    <section class="hero-section">
      <p class="hero-subtitle">SMPTE ST-2067<br/>for Rust and JavaScript.</p>
      <p class="hero-desc">Parse, validate, and inspect IMF packages with native Node.js bindings and a WebAssembly target for the browser.</p>
    </section>

    <!-- Feature cards -->
    <section class="section">
      <div class="card-grid four">
        <a class="feat-card" href={`${base}/reference/standards/`}>
          <h3>IMF core + applications</h3>
          <p>Parse AssetMaps, PKLs, and CPLs per SMPTE ST 2067-2, ST 2067-3, and Application profiles including ST 2067-21 and ST 2067-201.</p>
        </a>
        <a class="feat-card" href={`${base}/guide/config/`}>
          <h3>Flexible strictness</h3>
          <p>250+ validation rules across 8 SMPTE standards. Tune each rule individually: set any code to <code class="icode">off</code>, <code class="icode">info</code>, <code class="icode">warn</code>, <code class="icode">error</code>, or <code class="icode">critical</code> to match your workflow.</p>
        </a>
        <a class="feat-card" href={`${base}/guide/quick-start/`}>
          <h3>Rust, Node.js &amp; WASM</h3>
          <p>Use the native Rust library or CLI directly, <code class="icode">@imferno/node</code> bindings for server-side pipelines, or the WebAssembly build for the browser.</p>
        </a>
        <a class="feat-card" href={`${base}/guide/validation/`}>
          <h3>IMF reference corpus</h3>
          <p>Tested against the Netflix Photon MERIDIAN reference corpus. ST 2067-2, ST 2067-3, ST 2067-21, and ST 2067-201 fully covered.</p>
        </a>
      </div>
    </section>

    <!-- Get started -->
    <section class="section">
      <div class="card-grid two">
        <a class="get-started-card" href={`${base}/reference/cli/`}>
          <div class="gs-header"><span class="gs-icon">$</span><span class="gs-label">npx</span></div>
          <p class="gs-desc">No global install needed. Run the latest version directly.</p>
          <div class="codeblock">
            <code>npx imferno@latest validate ./my-package</code>
          </div>
        </a>
        <a class="get-started-card" href={`${base}/reference/rust/`}>
          <div class="gs-header"><span class="gs-icon">&#x1F980;</span><span class="gs-label">Rust</span></div>
          <p class="gs-desc">Install the native Rust binary. Offline, no runtime.</p>
          <div class="codeblock">
            <code>cargo install imferno</code>
            <code class="dim">imferno validate ./my-package</code>
          </div>
        </a>
        <a class="get-started-card" href={`${base}/reference/node/`}>
          <div class="gs-header"><span class="gs-icon">&#x1F4E6;</span><span class="gs-label">Node.js</span></div>
          <p class="gs-desc">Native bindings for server-side pipelines and automation.</p>
          <div class="codeblock">
            <code>npm install @imferno/node</code>
          </div>
        </a>
        <a class="get-started-card" href={`${base}/reference/wasm/`}>
          <div class="gs-header"><span class="gs-icon">&#x1F310;</span><span class="gs-label">WASM</span></div>
          <p class="gs-desc">ESM module powered by WebAssembly. Use it in any browser or bundler.</p>
          <div class="codeblock">
            <code>npm install imferno-wasm</code>
          </div>
        </a>
      </div>
    </section>

    <!-- IMF Playground -->
    <section class="section">
      <ImfPlayground client:only="react" />
    </section>

    <!-- Standards coverage -->
    <section class="section">
      <h2 class="section-title">Standards coverage</h2>
      <p class="section-subtitle">SMPTE ST-2067 implementation status.</p>
      <div class="table-wrap">
        <table class="std-table">
          <thead>
            <tr><th>Standard</th><th>Description</th><th>Status</th></tr>
          </thead>
          <tbody>
            <tr><td colspan="3" class="section-row">Complete</td></tr>
            <tr><td>ST 429-9</td><td>Volume Index / Asset Map</td><td><span class="badge done">Complete</span></td></tr>
            <tr><td>ST 2067-2:2013, :2016, :2020</td><td>Core Constraints &amp; Packing List</td><td><span class="badge done">Complete</span></td></tr>
            <tr><td>ST 2067-3:2013, :2016, :2020</td><td>Composition Playlist</td><td><span class="badge done">Complete</span></td></tr>
            <tr><td>ST 2067-21:2020, :2023, :2025</td><td>Application #2E (UHD/HDR)</td><td><span class="badge done">Complete</span></td></tr>
            <tr><td>ST 2067-201:2019, :2021</td><td>IAB Level 0 Plug-in</td><td><span class="badge done">Complete</span></td></tr>
            <tr><td>ST 2067-9:2018</td><td>Sidecar Composition Map</td><td><span class="badge done">Complete</span></td></tr>
            <tr><td>ST 2067-202:2022</td><td>ISXD Plug-in</td><td><span class="badge done">Complete</span></td></tr>
            <tr><td colspan="3" class="section-row">Partial</td></tr>
            <tr><td>ST 377-1:2011</td><td>MXF File Format</td><td><span class="badge partial">Partial</span></td></tr>
            <tr><td colspan="3" class="section-row">Not implemented</td></tr>
            <tr><td>ST 429-8</td><td>D-Cinema Packing List</td><td><span class="badge none">Not implemented</span></td></tr>
            <tr><td>ST 2067-100:2014</td><td>Output Profile List</td><td><span class="badge none">Not implemented</span></td></tr>
            <tr><td>ST 2067-203:2023</td><td>S-ADM Audio Plug-in</td><td><span class="badge none">Not implemented</span></td></tr>
            <tr><td>ST 377-41</td><td>MXF MGA / S-ADM Virtual Tracks</td><td><span class="badge none">Not implemented</span></td></tr>
            <tr><td>ST 379-2:2010</td><td>MXF Generic Container</td><td><span class="badge none">Not implemented</span></td></tr>
            <tr><td>ST 422:2014</td><td>JPEG 2000 in MXF</td><td><span class="badge none">Not implemented</span></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Sponsor -->
    <section class="section" style="text-align: center; padding-bottom: 4rem;">
      <p class="sponsor-text">
        If imferno is useful to your workflow, consider
        <a href="https://github.com/sponsors/jpwesselink" class="sponsor-link">sponsoring the project</a>.
      </p>
    </section>
  </div>

  <!-- Load WASM module -->
  <script is:inline define:vars={{ base, cacheBust: Date.now().toString(36) }}>
    (async function () {
      try {
        var mod = await import(base + '/wasm/imferno_wasm.js?v=' + cacheBust);
        await mod.default();
        window.__imfWasm = mod;
      } catch (e) {
        window.__imfWasmError = String(e);
      }
      window.dispatchEvent(new CustomEvent('imf-wasm-ready'));
    })();
  </script>
</StarlightPage>

<style is:global>
  /*
   * Homepage styles — uses is:global to bypass Astro's :where() scoping
   * so we can reliably override Starlight's content styles.
   */

  /* Kill Starlight's content-gap margin inside the homepage */
  .homepage h1,
  .homepage h2,
  .homepage h3,
  .homepage h4,
  .homepage p,
  .homepage section,
  .homepage div,
  .homepage table,
  .homepage th,
  .homepage td,
  .homepage code {
    margin-top: 0 !important;
    line-height: inherit;
  }

  /* Container — kill Starlight's content gap */
  .homepage {
    max-width: 1400px;
    margin: 0 auto;
    padding-inline: 48px;
    --sl-content-gap-y: 0 !important;
  }

  .homepage .section { padding-bottom: 2rem; }

  /* ── Card grids ── */
  .homepage .card-grid { display: grid !important; gap: 0.5rem; }
  .homepage .card-grid.four { grid-template-columns: repeat(4, 1fr) !important; }
  .homepage .card-grid.two { grid-template-columns: repeat(2, 1fr) !important; }
  @media (max-width: 960px) {
    .homepage .card-grid.four { grid-template-columns: repeat(2, 1fr) !important; }
  }
  @media (max-width: 600px) {
    .homepage { padding-inline: 24px; }
    .homepage .card-grid.four,
    .homepage .card-grid.two { grid-template-columns: 1fr !important; }
  }

  /* ── Feature cards ── */
  .homepage .feat-card {
    padding: 24px;
    border-radius: 12px;
    background: var(--hp-card-bg);
    border: 1px solid var(--hp-card-bg);
    transition: border-color 0.25s;
    min-width: 0;
    text-decoration: none !important;
    color: inherit !important;
    cursor: pointer;
  }
  .homepage .feat-card:hover { border-color: var(--sl-color-accent); }
  .homepage .feat-card h3 {
    font-size: 15px !important;
    font-weight: 600;
    color: var(--sl-color-text);
    margin: 0 0 8px !important;
    line-height: 1.3 !important;
  }
  .homepage .feat-card p {
    font-size: 13px !important;
    line-height: 1.6 !important;
    color: var(--sl-color-gray-3);
    margin: 0 !important;
  }

  /* Inline code */
  .homepage .icode {
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.9em !important;
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--hp-code-bg);
    color: var(--sl-color-accent);
  }

  /* ── Get started cards ── */
  .homepage .get-started-card {
    padding: 24px;
    border-radius: 12px;
    background: var(--hp-card-bg);
    border: 1px solid var(--sl-color-hairline);
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    text-decoration: none !important;
    color: inherit !important;
    transition: border-color 0.25s;
    cursor: pointer;
  }
  .homepage .get-started-card:hover { border-color: var(--sl-color-accent); }
  .homepage .gs-header { display: flex; align-items: center; gap: 10px; }
  .homepage .gs-icon { font-size: 20px; line-height: 1; }
  .homepage .gs-label { font-size: 15px !important; font-weight: 700; color: var(--sl-color-text); }
  .homepage .gs-desc { font-size: 13px !important; line-height: 1.6 !important; color: var(--sl-color-gray-3); margin: 0 !important; flex: 1; }
  .homepage .codeblock {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    border-radius: 8px;
    background: var(--hp-code-bg);
    border: 1px solid var(--sl-color-hairline);
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 13px !important;
    color: var(--sl-color-accent);
    overflow-x: auto;
  }
  .homepage .codeblock code {
    white-space: nowrap;
    font-size: inherit !important;
    padding: 0 !important;
    background: none !important;
    border: none !important;
  }
  .homepage .codeblock .dim { color: var(--sl-color-gray-4); }

  /* ── Standards table ── */
  .homepage .section-title { font-size: 1.5rem !important; font-weight: 700; color: var(--sl-color-text); margin-bottom: 0.5rem !important; }
  .homepage .section-subtitle { color: var(--sl-color-gray-3); font-size: 0.875rem !important; margin-bottom: 1.5rem !important; }
  .homepage .table-wrap { border-radius: 12px; overflow: hidden; border: 1px solid var(--sl-color-hairline); }
  .homepage .std-table { display: table !important; width: 100%; border-collapse: collapse; font-size: 16px !important; table-layout: auto; }
  .homepage .std-table th { text-align: left; padding: 14px 24px !important; color: var(--sl-color-gray-3); font-weight: 500; border-bottom: 1px solid var(--sl-color-hairline); }
  .homepage .std-table td { padding: 14px 24px !important; border-bottom: 1px solid var(--sl-color-hairline); color: var(--sl-color-text); font-size: 16px !important; }
  .homepage .std-table tr:last-child td { border-bottom: none; }
  .homepage .section-row {
    background: var(--hp-section-bg);
    color: var(--sl-color-gray-3);
    font-size: 11px !important;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 6px 16px !important;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .homepage .badge {
    display: inline-block;
    padding: 2px 8px !important;
    border-radius: 4px;
    font-size: 12px !important;
    font-weight: 500;
  }
  .homepage .badge.done { background: var(--hp-badge-done-bg); color: var(--hp-badge-done-fg); }
  .homepage .badge.partial { background: var(--hp-badge-partial-bg); color: var(--hp-badge-partial-fg); }
  .homepage .badge.none { background: var(--hp-badge-none-bg); color: var(--hp-badge-none-fg); }

  /* ── Hero ── */
  .homepage .hero-section {
    padding-top: 0;
    padding-bottom: 3rem;
    max-width: 640px;
  }
  .homepage .hero-subtitle {
    font-size: 48px !important;
    font-weight: 700;
    color: var(--sl-color-text);
    line-height: 56px !important;
    letter-spacing: -0.4px;
    margin: 0 0 12px !important;
  }
  .homepage .hero-desc {
    padding-top: 12px;
    font-size: 20px !important;
    font-weight: 500;
    line-height: 32px !important;
    color: var(--sl-color-gray-3);
    max-width: 576px;
    margin: 0 !important;
  }
  @media (max-width: 640px) {
    .homepage .hero-section { padding-top: 1.5rem; }
    .homepage .hero-subtitle { font-size: 32px !important; line-height: 40px !important; }
    .homepage .hero-desc { font-size: 18px !important; line-height: 28px !important; }
  }

  /* Sponsor */
  .homepage .sponsor-text { font-size: 14px !important; color: var(--sl-color-gray-4); }
  .homepage .sponsor-link { color: var(--sl-color-accent); text-decoration: underline; }
</style>
